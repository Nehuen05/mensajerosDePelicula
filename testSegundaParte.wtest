import paquete.*

describe "segunda parte" {

    test "test contratar mensajero" {
        empresaMensajeria.contratarMensajero(neo)
        assert.equals(1, empresaMensajeria.mensajeros.size())
    }

    test "test despedir mensajero" {
        empresaMensajeria.contratarMensajero(jeanGray)
        empresaMensajeria.despedirMensajero(jeanGray)
        assert.equals(0, empresaMensajeria.mensajeros.size())
    }

    test"tsest la mensajeria es grande" {
        empresaMensajeria.contratarMensajero(neo)
        empresaMensajeria.contratarMensajero(jeanGray)
        assert.equals(true, empresaMensajeria.laMensajeriaEsGrande())
    }

    test "test despedir a todos los mensajeros" {
        empresaMensajeria.contratarMensajero(neo)
        empresaMensajeria.contratarMensajero(jeanGray)
        empresaMensajeria.despedirATodosLosMensajeros()
        assert.equals(0, empresaMensajeria.mensajeros.size())
    }

    test "test mensajero puede enviar paquete" {
        empresaMensajeria.contratarMensajero(jeanGray)
        empresaMensajeria.contratarMensajero(neo)
        paquete.cambiarDestino(matrix)
        paquete.pagar()
        assert.equals(true, empresaMensajeria.primerMensajeroPuedeEnviarPaqueete(paquete))
    }

    test "test peso ultimo mensajero" {
        empresaMensajeria.contratarMensajero(jeanGray)
        empresaMensajeria.contratarMensajero(neo)
        assert.equals(0, empresaMensajeria.pesoUltimoMensajero())
    }
}