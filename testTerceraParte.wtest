import paquete.*
describe "test tercera parte" {
    test "alguien puede entregar paquete" {
        empresaMensajeria.contratarMensajero(jeanGray)
        empresaMensajeria.contratarMensajero(neo)
        paquetito.cambiarDestino(matrix)
        assert.that(empresaMensajeria.hayAlgunMensajeroPuedenEnviarPaquete(paquetito, matrix))
    }
}