import paquete.*

describe "test PAQUETE" {

    test "test 1" {
        paquete.cambiarDestino(matrix)
        assert.equals(paquete.precioXDestino(), 500)
    }

    test "test 2" {
        paquete.cambiarDestino(puenteDeBrooklyn)
        assert.equals(paquete.precioXDestino(), 150)
    }

    test "test 3" {
        paquete.pagar()
        assert.that(paquete.estaPagado())
    }
}

describe "test envio" {
    
    test "test Neo" {
        paquete.assignarRepartidor(neo)
        paquete.cambiarDestino(matrix)
        assert.notThat(paquete.puedeEntregar(neo))
    }

    test "test Jean "{
        paquete.assignarRepartidor(jeanGray)
        paquete.cambiarDestino(matrix)
        paquete.pagar()
        assert.that(paquete.puedeEntregar(jeanGray))
    }

    test "test Sara 1" {
        paquete.assignarRepartidor(saraConnor)
        saraConnor.cambiarPeso(70)
        paquete.cambiarDestino(puenteDeBrooklyn)
        saraConnor.cambiarVehiculo(camion)
        camion.cambiarAcoplados(1)
        paquete.pagar()
        assert.notThat(paquete.puedeEntregar(saraConnor))
    }

    test "test Sara 2" {
        paquete.assignarRepartidor(saraConnor)
        saraConnor.cambiarPeso(70)
        paquete.cambiarDestino(puenteDeBrooklyn)
        saraConnor.cambiarVehiculo(moto)
        paquete.pagar()
        assert.that(paquete.puedeEntregar(saraConnor))
    }
}
