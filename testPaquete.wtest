import paquete.*

describe "test PAQUETE" {

    test "test 1" {
        assert.equals(paquete.precio(matrix), 500)
    }

    test "test 3" {
        paquete.pagar()
        assert.that(paquete.estaPagado())
    }
}

describe "test envio" {
    
    test "test Neo" {
        assert.notThat(paquete.puedeMensajeroEntregar(neo,matrix))
    }

    test "test Jean "{
        paquete.pagar()
        assert.that(paquete.puedeMensajeroEntregar(jeanGray, matrix))
    }

    test "test Sara 1" {
        saraConnor.cambiarPeso(70)
        saraConnor.cambiarVehiculo(camion)
        camion.cambiarAcoplados(1)
        paquete.pagar()
        assert.notThat(paquete.puedeMensajeroEntregar(saraConnor, puenteDeBrooklyn))
    }
  
    test "test Sara 2" {
        saraConnor.cambiarPeso(70)
        saraConnor.cambiarVehiculo(moto)
        paquete.pagar()
        assert.that(paquete.puedeMensajeroEntregar(saraConnor, puenteDeBrooklyn))
    }
}
