import paquete.*

describe "test PAQUETE" {

    test "test 1" {
        paquete.cambiarDestino("matrix")
        assert.equals(500, paquete.precioXDestino())
    }

    test "test 2" {
        paquete.cambiarDestino("puenteDeBrooklyn")
        assert.equals(150, paquete.precioXDestino())
    }

    test "test 3" {
        paquete.pagar()
        assert.that(paquete.estaPagado())
    }
}

describe "test envio" {
    
    test "test Neo" {
        paquete.assignarRepartidor(neo)
        paquete.cambiarDestino("matrix")
        assert.notThat(paquete.sePuedeEntregar(neo))
    }

    test "test Jean "{
        paquete.assignarRepartidor(jeanGray)
        paquete.cambiarDestino("matrix")
        paquete.pagar()
        assert.that(paquete.sePuedeEntregar(jeanGray))
    }

    test "test Sara 1" {
        paquete.assignarRepartidor(saraConnor)
        saraConnor.cambiarPeso(70)
        paquete.cambiarDestino("puenteDeBrooklyn")
        saraConnor.cambiarVehiculo(camion)
        camion.cambiarAcoplados(1)
        paquete.pagar()
        assert.notThat(paquete.sePuedeEntregar(saraConnor))
    }

    test "test Sara 2" {
        paquete.assignarRepartidor(saraConnor)
        saraConnor.cambiarPeso(70)
        paquete.cambiarDestino("puenteDeBrooklyn")
        saraConnor.cambiarVehiculo(moto)
        paquete.pagar()
        assert.that(paquete.sePuedeEntregar(saraConnor))
    }
}
